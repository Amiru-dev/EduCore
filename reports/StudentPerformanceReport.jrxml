<?xml version="1.0" encoding="UTF-8"?>
<jasperReport name="StudentPerformanceReport" pageWidth="595" pageHeight="842" columnWidth="535" leftMargin="30" rightMargin="30" topMargin="20" bottomMargin="20">
	<parameter name="student_id" class="java.lang.String"/>
	<query>
		<![CDATA[SELECT r.student_id, s.first_name, s.last_name, e.exam_name, sub.subject_name, r.marks_obtained, r.grade_letter, e.max_marks
		FROM result r
		JOIN student s ON r.student_id = s.student_id
		JOIN exam e ON r.exam_id = e.exam_id
		JOIN subject sub ON e.subject_id = sub.subject_id
		WHERE r.student_id = $P{student_id}
		ORDER BY e.exam_date DESC]]>
	</query>
	<field name="student_id" class="java.lang.String"/>
	<field name="first_name" class="java.lang.String"/>
	<field name="last_name" class="java.lang.String"/>
	<field name="exam_name" class="java.lang.String"/>
	<field name="subject_name" class="java.lang.String"/>
	<field name="marks_obtained" class="java.lang.Double"/>
	<field name="grade_letter" class="java.lang.String"/>
	<field name="max_marks" class="java.lang.Double"/>
	<title height="60">
		<element kind="staticText" x="0" y="0" width="535" height="30" hTextAlign="Center" fontSize="16" bold="true">
			<text><![CDATA[Student Performance Report]]></text>
		</element>
		<element kind="staticText" x="0" y="34" width="100" height="20">
			<text><![CDATA[Student ID:]]></text>
		</element>
		<element kind="textField" x="100" y="34" width="150" height="20">
			<expression><![CDATA[$F{student_id}]]></expression>
		</element>
		<element kind="staticText" x="250" y="34" width="80" height="20">
			<text><![CDATA[Name:]]></text>
		</element>
		<element kind="textField" x="330" y="34" width="200" height="20">
			<expression><![CDATA[$F{first_name} + " " + $F{last_name}]]></expression>
		</element>
	</title>
	<pageHeader height="30">
		<element kind="staticText" x="0" y="0" width="200" height="20">
			<text><![CDATA[Central College Anuradhapura]]></text>
		</element>
	</pageHeader>
	<columnHeader height="25">
		<element kind="staticText" x="0" y="0" width="100" height="20">
			<text><![CDATA[Exam Name]]></text>
		</element>
		<element kind="staticText" x="100" y="0" width="100" height="20">
			<text><![CDATA[Subject]]></text>
		</element>
		<element kind="staticText" x="200" y="0" width="80" height="20">
			<text><![CDATA[Marks]]></text>
		</element>
		<element kind="staticText" x="280" y="0" width="80" height="20">
			<text><![CDATA[Max Marks]]></text>
		</element>
		<element kind="staticText" x="360" y="0" width="50" height="20">
			<text><![CDATA[Grade]]></text>
		</element>
	</columnHeader>
	<detail>
		<band height="25">
			<element kind="textField" x="0" y="0" width="100" height="20">
				<expression><![CDATA[$F{exam_name}]]></expression>
			</element>
			<element kind="textField" x="100" y="0" width="100" height="20">
				<expression><![CDATA[$F{subject_name}]]></expression>
			</element>
			<element kind="textField" x="200" y="0" width="80" height="20">
				<expression><![CDATA[$F{marks_obtained}]]></expression>
			</element>
			<element kind="textField" x="280" y="0" width="80" height="20">
				<expression><![CDATA[$F{max_marks}]]></expression>
			</element>
			<element kind="textField" x="360" y="0" width="50" height="20">
				<expression><![CDATA[$F{grade_letter}]]></expression>
			</element>
		</band>
	</detail>
	<pageFooter height="30">
		<element kind="textField" x="0" y="10" width="535" height="20" hTextAlign="Center">
			<expression><![CDATA["Page " + $V{PAGE_NUMBER} + " of " + $V{PAGE_COUNT}]]></expression>
		</element>
	</pageFooter>
</jasperReport>
