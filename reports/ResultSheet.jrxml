<?xml version="1.0" encoding="UTF-8"?>
<jasperReport xmlns="http://jasperreports.sourceforge.net/jasperreports" name="ResultSheet" pageWidth="595" pageHeight="842" columnWidth="535" leftMargin="30" rightMargin="30" topMargin="20" bottomMargin="20">
	<parameter name="exam_id" class="java.lang.Integer"/>
	<queryString>
		SELECT r.student_id, s.first_name, s.last_name, r.marks_obtained, r.grade_letter, e.exam_name, sub.subject_name
		FROM result r
		JOIN student s ON r.student_id = s.student_id
		JOIN exam e ON r.exam_id = e.exam_id
		JOIN subject sub ON e.subject_id = sub.subject_id
		WHERE r.exam_id = $P{exam_id}
		ORDER BY r.marks_obtained DESC
	</queryString>
	<field name="student_id" class="java.lang.String"/>
	<field name="first_name" class="java.lang.String"/>
	<field name="last_name" class="java.lang.String"/>
	<field name="marks_obtained" class="java.lang.Double"/>
	<field name="grade_letter" class="java.lang.String"/>
	<field name="exam_name" class="java.lang.String"/>
	<field name="subject_name" class="java.lang.String"/>
	<title>
		<band height="50">
			<staticText>
				<reportElement x="0" y="0" width="535" height="30" textAlignment="Center"/>
				<font size="16" isBold="true"/>
				<text><![CDATA[Result Sheet]]></text>
			</staticText>
		</band>
	</title>
	<columnHeader>
		<band height="25">
			<staticText><reportElement x="0" y="0" width="80" height="20"/><text><![CDATA[Student ID]]></text></staticText>
			<staticText><reportElement x="80" y="0" width="100" height="20"/><text><![CDATA[Name]]></text></staticText>
			<staticText><reportElement x="180" y="0" width="80" height="20"/><text><![CDATA[Marks]]></text></staticText>
			<staticText><reportElement x="260" y="0" width="50" height="20"/><text><![CDATA[Grade]]></text></staticText>
			<staticText><reportElement x="310" y="0" width="100" height="20"/><text><![CDATA[Subject]]></text></staticText>
		</band>
	</columnHeader>
	<detail>
		<band height="25">
			<textField><reportElement x="0" y="0" width="80" height="20"/><textFieldExpression><![CDATA[$F{student_id}]]></textFieldExpression></textField>
			<textField><reportElement x="80" y="0" width="100" height="20"/><textFieldExpression><![CDATA[$F{first_name} + " " + $F{last_name}]]></textFieldExpression></textField>
			<textField><reportElement x="180" y="0" width="80" height="20"/><textFieldExpression><![CDATA[$F{marks_obtained}]]></textFieldExpression></textField>
			<textField><reportElement x="260" y="0" width="50" height="20"/><textFieldExpression><![CDATA[$F{grade_letter}]]></textFieldExpression></textField>
			<textField><reportElement x="310" y="0" width="100" height="20"/><textFieldExpression><![CDATA[$F{subject_name}]]></textFieldExpression></textField>
		</band>
	</detail>
</jasperReport>