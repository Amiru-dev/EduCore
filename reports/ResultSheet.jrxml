<jasperReport xmlns="http://jasperreports.sourceforge.net/jasperreports" xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance" xsi:schemaLocation="http://jasperreports.sourceforge.net/jasperreports http://jasperreports.sourceforge.net/xsd/jasperreport.xsd" name="ResultSheet" pageWidth="595" pageHeight="842" columnWidth="535" leftMargin="30" rightMargin="30" topMargin="20" bottomMargin="20" uuid="c308fb74-3796-4120-97f0-ff166672777d">
	<parameter name="exam_id" class="java.lang.Integer"/>
	<queryString>
		<![CDATA[SELECT r.student_id, s.first_name, s.last_name, r.marks_obtained, r.grade_letter, e.exam_name, sub.subject_name
		FROM result r
		JOIN student s ON r.student_id = s.student_id
		JOIN exam e ON r.exam_id = e.exam_id
		JOIN subject sub ON e.subject_id = sub.subject_id
		WHERE r.exam_id = $P{exam_id}
		ORDER BY r.marks_obtained DESC]]>
	</queryString>
	<field name="student_id" class="java.lang.String"/>
	<field name="first_name" class="java.lang.String"/>
	<field name="last_name" class="java.lang.String"/>
	<field name="marks_obtained" class="java.lang.Double"/>
	<field name="grade_letter" class="java.lang.String"/>
	<field name="exam_name" class="java.lang.String"/>
	<field name="subject_name" class="java.lang.String"/>
