<?xml version="1.0" encoding="UTF-8"?>
<jasperReport name="GuardianReport" pageWidth="595" pageHeight="842" columnWidth="535" leftMargin="30" rightMargin="30" topMargin="20" bottomMargin="20">
	<query>
		<![CDATA[SELECT g.guardian_id, g.first_name, g.last_name, g.nic, g.relationship, g.phone, g.email, g.address
		FROM guardian g
		ORDER BY g.first_name, g.last_name]]>
	</query>
	<field name="guardian_id" class="java.lang.Integer"/>
	<field name="first_name" class="java.lang.String"/>
	<field name="last_name" class="java.lang.String"/>
	<field name="nic" class="java.lang.String"/>
	<field name="relationship" class="java.lang.String"/>
	<field name="phone" class="java.lang.String"/>
	<field name="email" class="java.lang.String"/>
	<field name="address" class="java.lang.String"/>
	<title height="50">
		<element kind="staticText" x="0" y="0" width="535" height="30" hTextAlign="Center" fontSize="16" bold="true">
			<text><![CDATA[Guardian Report]]></text>
		</element>
	</title>
	<pageHeader height="30">
		<element kind="staticText" x="0" y="0" width="200" height="20">
			<text><![CDATA[Central College Anuradhapura]]></text>
		</element>
	</pageHeader>
	<columnHeader height="25">
		<element kind="staticText" x="0" y="0" width="80" height="20">
			<text><![CDATA[Guardian ID]]></text>
		</element>
		<element kind="staticText" x="80" y="0" width="100" height="20">
			<text><![CDATA[Name]]></text>
		</element>
		<element kind="staticText" x="180" y="0" width="80" height="20">
			<text><![CDATA[NIC]]></text>
		</element>
		<element kind="staticText" x="260" y="0" width="80" height="20">
			<text><![CDATA[Relationship]]></text>
		</element>
		<element kind="staticText" x="340" y="0" width="80" height="20">
			<text><![CDATA[Phone]]></text>
		</element>
	</columnHeader>
	<detail>
		<band height="25">
			<element kind="textField" x="0" y="0" width="80" height="20">
				<expression><![CDATA[$F{guardian_id}]]></expression>
			</element>
			<element kind="textField" x="80" y="0" width="100" height="20">
				<expression><![CDATA[$F{first_name} + " " + $F{last_name}]]></expression>
			</element>
			<element kind="textField" x="180" y="0" width="80" height="20">
				<expression><![CDATA[$F{nic}]]></expression>
			</element>
			<element kind="textField" x="260" y="0" width="80" height="20">
				<expression><![CDATA[$F{relationship}]]></expression>
			</element>
			<element kind="textField" x="340" y="0" width="80" height="20">
				<expression><![CDATA[$F{phone}]]></expression>
			</element>
		</band>
	</detail>
	<pageFooter height="30">
		<element kind="textField" x="0" y="10" width="535" height="20" hTextAlign="Center">
			<expression><![CDATA["Page " + $V{PAGE_NUMBER} + " of " + $V{PAGE_COUNT}]]></expression>
		</element>
	</pageFooter>
</jasperReport>
