	<queryString>
		<![CDATA[SELECT ft.finance_id, tt.type_name, ft.amount, ft.description, ft.transaction_date
		FROM finance ft
		JOIN transaction_type tt ON ft.transaction_type_id = tt.transaction_type_id
		ORDER BY ft.transaction_date DESC]]>
	</queryString>
