<?xml version="1.0" encoding="UTF-8"?>
<jasperReport xmlns="http://jasperreports.sourceforge.net/jasperreports" name="FinanceReport" pageWidth="595" pageHeight="842" columnWidth="535" leftMargin="30" rightMargin="30" topMargin="20" bottomMargin="20">
	<queryString>
		SELECT ft.transaction_id, ft.transaction_type, ft.amount, ft.description, ft.transaction_date
		FROM finance_transaction ft
		ORDER BY ft.transaction_date DESC
	</queryString>
	<field name="transaction_id" class="java.lang.Integer"/>
	<field name="transaction_type" class="java.lang.String"/>
	<field name="amount" class="java.lang.Double"/>
	<field name="description" class="java.lang.String"/>
	<field name="transaction_date" class="java.sql.Date"/>
	<title>
		<band height="50">
			<staticText>
				<reportElement x="0" y="0" width="535" height="30" textAlignment="Center"/>
				<font size="16" isBold="true"/>
				<text><![CDATA[Finance Report]]></text>
			</staticText>
		</band>
	</title>
	<columnHeader>
		<band height="25">
			<staticText><reportElement x="0" y="0" width="80" height="20"/><text><![CDATA[Transaction ID]]></text></staticText>
			<staticText><reportElement x="80" y="0" width="100" height="20"/><text><![CDATA[Type]]></text></staticText>
			<staticText><reportElement x="180" y="0" width="80" height="20"/><text><![CDATA[Amount]]></text></staticText>
			<staticText><reportElement x="260" y="0" width="150" height="20"/><text><![CDATA[Description]]></text></staticText>
			<staticText><reportElement x="410" y="0" width="80" height="20"/><text><![CDATA[Date]]></text></staticText>
		</band>
	</columnHeader>
	<detail>
		<band height="25">
			<textField><reportElement x="0" y="0" width="80" height="20"/><textFieldExpression><![CDATA[$F{transaction_id}]]></textFieldExpression></textField>
			<textField><reportElement x="80" y="0" width="100" height="20"/><textFieldExpression><![CDATA[$F{transaction_type}]]></textFieldExpression></textField>
			<textField pattern="Rs. #,##0.00"><reportElement x="180" y="0" width="80" height="20"/><textFieldExpression><![CDATA[$F{amount}]]></textFieldExpression></textField>
			<textField><reportElement x="260" y="0" width="150" height="20"/><textFieldExpression><![CDATA[$F{description}]]></textFieldExpression></textField>
			<textField pattern="yyyy-MM-dd"><reportElement x="410" y="0" width="80" height="20"/><textFieldExpression><![CDATA[$F{transaction_date}]]></textFieldExpression></textField>
		</band>
	</detail>
</jasperReport>