<?xml version="1.0" encoding="UTF-8"?>
<jasperReport name="AttendanceReport" pageWidth="595" pageHeight="842" columnWidth="535" leftMargin="30" rightMargin="30" topMargin="20" bottomMargin="20">
	<query>
		<![CDATA[SELECT sa.student_id, s.first_name, s.last_name, sa.status, sa.date_time
		FROM student_attendance sa
		JOIN student s ON sa.student_id = s.student_id
		WHERE sa.date_time >= DATE_SUB(CURDATE(), INTERVAL 30 DAY)
		ORDER BY sa.date_time DESC]]>
	</query>
	<field name="student_id" class="java.lang.String"/>
	<field name="first_name" class="java.lang.String"/>
	<field name="last_name" class="java.lang.String"/>
	<field name="status" class="java.lang.String"/>
	<field name="date_time" class="java.sql.Timestamp"/>
	<title height="50">
		<element kind="staticText" x="0" y="0" width="535" height="30" hTextAlign="Center" fontSize="16" bold="true">
			<text><![CDATA[Attendance Report (Last 30 Days)]]></text>
		</element>
	</title>
	<pageHeader height="30">
		<element kind="staticText" x="0" y="0" width="200" height="20">
			<text><![CDATA[Central College Anuradhapura]]></text>
		</element>
	</pageHeader>
	<columnHeader height="25">
		<element kind="staticText" x="0" y="0" width="80" height="20">
			<text><![CDATA[Student ID]]></text>
		</element>
		<element kind="staticText" x="80" y="0" width="100" height="20">
			<text><![CDATA[Name]]></text>
		</element>
		<element kind="staticText" x="180" y="0" width="80" height="20">
			<text><![CDATA[Status]]></text>
		</element>
		<element kind="staticText" x="260" y="0" width="160" height="20">
			<text><![CDATA[Date/Time]]></text>
		</element>
	</columnHeader>
	<detail>
		<band height="25">
			<element kind="textField" x="0" y="0" width="80" height="20">
				<expression><![CDATA[$F{student_id}]]></expression>
			</element>
			<element kind="textField" x="80" y="0" width="100" height="20">
				<expression><![CDATA[$F{first_name} + " " + $F{last_name}]]></expression>
			</element>
			<element kind="textField" x="180" y="0" width="80" height="20">
				<expression><![CDATA[$F{status}]]></expression>
			</element>
			<element kind="textField" x="260" y="0" width="160" height="20" pattern="yyyy-MM-dd HH:mm">
				<expression><![CDATA[$F{date_time}]]></expression>
			</element>
		</band>
	</detail>
	<pageFooter height="30">
		<element kind="textField" x="0" y="10" width="535" height="20" hTextAlign="Center">
			<expression><![CDATA["Page " + $V{PAGE_NUMBER} + " of " + $V{PAGE_COUNT}]]></expression>
		</element>
	</pageFooter>
</jasperReport>
