<?xml version="1.0" encoding="UTF-8"?>
<jasperReport xmlns="http://jasperreports.sourceforge.net/jasperreports" name="AttendanceReport" pageWidth="595" pageHeight="842" columnWidth="535" leftMargin="30" rightMargin="30" topMargin="20" bottomMargin="20">
	<queryString>
		SELECT sa.student_id, s.first_name, s.last_name, sa.status, sa.date_time
		FROM student_attendance sa
		JOIN student s ON sa.student_id = s.student_id
		WHERE sa.date_time >= DATE_SUB(CURDATE(), INTERVAL 30 DAY)
		ORDER BY sa.date_time DESC
	</queryString>
	<field name="student_id" class="java.lang.String"/>
	<field name="first_name" class="java.lang.String"/>
	<field name="last_name" class="java.lang.String"/>
	<field name="status" class="java.lang.String"/>
	<field name="date_time" class="java.sql.Timestamp"/>
	<title>
		<band height="50">
			<staticText>
				<reportElement x="0" y="0" width="535" height="30" textAlignment="Center"/>
				<font size="16" isBold="true"/>
				<text><![CDATA[Attendance Report (Last 30 Days)]]></text>
			</staticText>
		</band>
	</title>
	<columnHeader>
		<band height="25">
			<staticText><reportElement x="0" y="0" width="80" height="20"/><text><![CDATA[Student ID]]></text></staticText>
			<staticText><reportElement x="80" y="0" width="100" height="20"/><text><![CDATA[Name]]></text></staticText>
			<staticText><reportElement x="180" y="0" width="80" height="20"/><text><![CDATA[Status]]></text></staticText>
			<staticText><reportElement x="260" y="0" width="100" height="20"/><text><![CDATA[Date/Time]]></text></staticText>
		</band>
	</columnHeader>
	<detail>
		<band height="25">
			<textField><reportElement x="0" y="0" width="80" height="20"/><textFieldExpression><![CDATA[$F{student_id}]]></textFieldExpression></textField>
			<textField><reportElement x="80" y="0" width="100" height="20"/><textFieldExpression><![CDATA[$F{first_name} + " " + $F{last_name}]]></textFieldExpression></textField>
			<textField><reportElement x="180" y="0" width="80" height="20"/><textFieldExpression><![CDATA[$F{status}]]></textFieldExpression></textField>
			<textField pattern="yyyy-MM-dd HH:mm"><reportElement x="260" y="0" width="100" height="20"/><textFieldExpression><![CDATA[$F{date_time}]]></textFieldExpression></textField>
		</band>
	</detail>
</jasperReport>