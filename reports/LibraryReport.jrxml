	<queryString>
		<![CDATA[SELECT b.ISBN, b.title, b.author, bc.category_name, b.available_qty, b.quantity
		FROM book b
		JOIN book_category bc ON b.category_id = bc.category_id
		ORDER BY b.title]]>
	</queryString>
