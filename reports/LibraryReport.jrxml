<?xml version="1.0" encoding="UTF-8"?>
<jasperReport name="LibraryReport" pageWidth="595" pageHeight="842" columnWidth="535" leftMargin="30" rightMargin="30" topMargin="20" bottomMargin="20">
	<query>
		<![CDATA[SELECT b.ISBN, b.title, b.author, bc.category_name, b.available_qty, b.quantity
		FROM book b
		JOIN book_category bc ON b.category_id = bc.category_id
		ORDER BY b.title]]>
	</query>
	<field name="ISBN" class="java.lang.String"/>
	<field name="title" class="java.lang.String"/>
	<field name="author" class="java.lang.String"/>
	<field name="category_name" class="java.lang.String"/>
	<field name="available_qty" class="java.lang.Integer"/>
	<field name="quantity" class="java.lang.Integer"/>
	<title height="50">
		<element kind="staticText" x="0" y="0" width="535" height="30" hTextAlign="Center" fontSize="16" bold="true">
			<text><![CDATA[Library Inventory Report]]></text>
		</element>
	</title>
	<pageHeader height="30">
		<element kind="staticText" x="0" y="0" width="200" height="20">
			<text><![CDATA[Central College Anuradhapura]]></text>
		</element>
	</pageHeader>
	<columnHeader height="25">
		<element kind="staticText" x="0" y="0" width="100" height="20">
			<text><![CDATA[ISBN]]></text>
		</element>
		<element kind="staticText" x="100" y="0" width="150" height="20">
			<text><![CDATA[Title]]></text>
		</element>
		<element kind="staticText" x="250" y="0" width="100" height="20">
			<text><![CDATA[Author]]></text>
		</element>
		<element kind="staticText" x="350" y="0" width="80" height="20">
			<text><![CDATA[Category]]></text>
		</element>
		<element kind="staticText" x="430" y="0" width="50" height="20">
			<text><![CDATA[Available]]></text>
		</element>
	</columnHeader>
	<detail>
		<band height="25">
			<element kind="textField" x="0" y="0" width="100" height="20">
				<expression><![CDATA[$F{ISBN}]]></expression>
			</element>
			<element kind="textField" x="100" y="0" width="150" height="20">
				<expression><![CDATA[$F{title}]]></expression>
			</element>
			<element kind="textField" x="250" y="0" width="100" height="20">
				<expression><![CDATA[$F{author}]]></expression>
			</element>
			<element kind="textField" x="350" y="0" width="80" height="20">
				<expression><![CDATA[$F{category_name}]]></expression>
			</element>
			<element kind="textField" x="430" y="0" width="50" height="20">
				<expression><![CDATA[$F{available_qty}]]></expression>
			</element>
		</band>
	</detail>
	<pageFooter height="30">
		<element kind="textField" x="0" y="10" width="535" height="20" hTextAlign="Center">
			<expression><![CDATA["Page " + $V{PAGE_NUMBER} + " of " + $V{PAGE_COUNT}]]></expression>
		</element>
	</pageFooter>
</jasperReport>
