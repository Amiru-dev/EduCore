<?xml version="1.0" encoding="UTF-8"?>
<jasperReport xmlns="http://jasperreports.sourceforge.net/jasperreports" name="LibraryReport" pageWidth="595" pageHeight="842" columnWidth="535" leftMargin="30" rightMargin="30" topMargin="20" bottomMargin="20">
	<queryString>
		SELECT b.ISBN, b.title, b.author, c.category_name, b.available_copies, b.total_copies
		FROM book b
		JOIN category c ON b.category_id = c.category_id
		ORDER BY b.title
	</queryString>
	<field name="ISBN" class="java.lang.String"/>
	<field name="title" class="java.lang.String"/>
	<field name="author" class="java.lang.String"/>
	<field name="category_name" class="java.lang.String"/>
	<field name="available_copies" class="java.lang.Integer"/>
	<field name="total_copies" class="java.lang.Integer"/>
	<title>
		<band height="50">
			<staticText>
				<reportElement x="0" y="0" width="535" height="30" textAlignment="Center"/>
				<font size="16" isBold="true"/>
				<text><![CDATA[Library Inventory Report]]></text>
			</staticText>
		</band>
	</title>
	<columnHeader>
		<band height="25">
			<staticText><reportElement x="0" y="0" width="100" height="20"/><text><![CDATA[ISBN]]></text></staticText>
			<staticText><reportElement x="100" y="0" width="150" height="20"/><text><![CDATA[Title]]></text></staticText>
			<staticText><reportElement x="250" y="0" width="100" height="20"/><text><![CDATA[Author]]></text></staticText>
			<staticText><reportElement x="350" y="0" width="80" height="20"/><text><![CDATA[Category]]></text></staticText>
			<staticText><reportElement x="430" y="0" width="50" height="20"/><text><![CDATA[Available]]></text></staticText>
		</band>
	</columnHeader>
	<detail>
		<band height="25">
			<textField><reportElement x="0" y="0" width="100" height="20"/><textFieldExpression><![CDATA[$F{ISBN}]]></textFieldExpression></textField>
			<textField><reportElement x="100" y="0" width="150" height="20"/><textFieldExpression><![CDATA[$F{title}]]></textFieldExpression></textField>
			<textField><reportElement x="250" y="0" width="100" height="20"/><textFieldExpression><![CDATA[$F{author}]]></textFieldExpression></textField>
			<textField><reportElement x="350" y="0" width="80" height="20"/><textFieldExpression><![CDATA[$F{category_name}]]></textFieldExpression></textField>
			<textField><reportElement x="430" y="0" width="50" height="20"/><textFieldExpression><![CDATA[$F{available_covers}]]></textFieldExpression></textField>
		</band>
	</detail>
</jasperReport>