<?xml version="1.0" encoding="UTF-8"?>
<jasperReport name="PendingFeesReport" pageWidth="595" pageHeight="842" columnWidth="535" leftMargin="30" rightMargin="30" topMargin="20" bottomMargin="20">
	<query>
		<![CDATA[SELECT f.student_id, s.first_name, s.last_name, ft.fee_type_name, f.amount, f.due_date
		FROM fee f
		JOIN student s ON f.student_id = s.student_id
		JOIN fee_type ft ON f.fee_type_id = ft.fee_type_id
		WHERE f.status != 'Paid'
		ORDER BY f.due_date ASC]]>
	</query>
	<field name="student_id" class="java.lang.String"/>
	<field name="first_name" class="java.lang.String"/>
	<field name="last_name" class="java.lang.String"/>
	<field name="fee_type_name" class="java.lang.String"/>
	<field name="amount" class="java.lang.Double"/>
	<field name="due_date" class="java.sql.Date"/>
	<title height="50">
		<element kind="staticText" x="0" y="0" width="535" height="30" hTextAlign="Center" fontSize="16" bold="true">
			<text><![CDATA[Pending Fees Report]]></text>
		</element>
	</title>
	<pageHeader height="30">
		<element kind="staticText" x="0" y="0" width="200" height="20">
			<text><![CDATA[Central College Anuradhapura]]></text>
		</element>
	</pageHeader>
	<columnHeader height="25">
		<element kind="staticText" x="0" y="0" width="80" height="20">
			<text><![CDATA[Student ID]]></text>
		</element>
		<element kind="staticText" x="80" y="0" width="100" height="20">
			<text><![CDATA[Name]]></text>
		</element>
		<element kind="staticText" x="180" y="0" width="80" height="20">
			<text><![CDATA[Fee Type]]></text>
		</element>
		<element kind="staticText" x="260" y="0" width="80" height="20">
			<text><![CDATA[Amount]]></text>
		</element>
		<element kind="staticText" x="340" y="0" width="80" height="20">
			<text><![CDATA[Due Date]]></text>
		</element>
	</columnHeader>
	<detail>
		<band height="25">
			<element kind="textField" x="0" y="0" width="80" height="20">
				<expression><![CDATA[$F{student_id}]]></expression>
			</element>
			<element kind="textField" x="80" y="0" width="100" height="20">
				<expression><![CDATA[$F{first_name} + " " + $F{last_name}]]></expression>
			</element>
			<element kind="textField" x="180" y="0" width="80" height="20">
				<expression><![CDATA[$F{fee_type_name}]]></expression>
			</element>
			<element kind="staticText" x="260" y="0" width="25" height="20">
				<text><![CDATA[Rs.]]></text>
			</element>
			<element kind="textField" x="285" y="0" width="55" height="20" pattern="#,##0.00">
				<expression><![CDATA[$F{amount}]]></expression>
			</element>
			<element kind="textField" x="340" y="0" width="80" height="20" pattern="yyyy-MM-dd">
				<expression><![CDATA[$F{due_date}]]></expression>
			</element>
		</band>
	</detail>
	<pageFooter height="30">
		<element kind="textField" x="0" y="10" width="535" height="20" hTextAlign="Center">
			<expression><![CDATA["Page " + $V{PAGE_NUMBER} + " of " + $V{PAGE_COUNT}]]></expression>
		</element>
	</pageFooter>
</jasperReport>
