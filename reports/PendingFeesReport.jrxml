<jasperReport xmlns="http://jasperreports.sourceforge.net/jasperreports" xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance" xsi:schemaLocation="http://jasperreports.sourceforge.net/jasperreports http://jasperreports.sourceforge.net/xsd/jasperreport.xsd" name="PendingFeesReport" pageWidth="595" pageHeight="842" columnWidth="535" leftMargin="30" rightMargin="30" topMargin="20" bottomMargin="20" uuid="22602ba7-a0c9-4b32-8d2e-d5043687083b">
	<queryString>
		<![CDATA[SELECT f.receipt_no, f.student_id, s.first_name, s.last_name, ft.fee_type_name, f.amount, f.due_date
		FROM fee f
		JOIN student s ON f.student_id = s.student_id
		JOIN fee_type ft ON f.fee_type_id = ft.fee_type_id
		WHERE f.status != 'Paid'
		ORDER BY f.due_date ASC]]>
	</queryString>
	<field name="receipt_no" class="java.lang.String"/>
	<field name="student_id" class="java.lang.String"/>
	<field name="first_name" class="java.lang.String"/>
	<field name="last_name" class="java.lang.String"/>
	<field name="fee_type_name" class="java.lang.String"/>
	<field name="amount" class="java.lang.Double"/>
	<field name="due_date" class="java.sql.Date"/>
