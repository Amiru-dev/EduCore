<?xml version="1.0" encoding="UTF-8"?>
<jasperReport xmlns="http://jasperreports.sourceforge.net/jasperreports" name="ExamScheduleReport" pageWidth="595" pageHeight="842" columnWidth="535" leftMargin="30" rightMargin="30" topMargin="20" bottomMargin="20">
	<queryString>
		SELECT e.exam_id, e.exam_name, sub.subject_name, g.grade_name, e.exam_date, e.max_marks, et.exam_type_name
		FROM exam e
		JOIN subject sub ON e.subject_id = sub.subject_id
		JOIN grade g ON e.grade_id = g.grade_id
		JOIN exam_type et ON e.exam_type_id = et.exam_type_id
		ORDER BY e.exam_date DESC
	</queryString>
	<field name="exam_id" class="java.lang.Integer"/>
	<field name="exam_name" class="java.lang.String"/>
	<field name="subject_name" class="java.lang.String"/>
	<field name="grade_name" class="java.lang.String"/>
	<field name="exam_date" class="java.sql.Date"/>
	<field name="max_marks" class="java.lang.Double"/>
	<field name="exam_type_name" class="java.lang.String"/>
	<title>
		<band height="50">
			<staticText>
				<reportElement x="0" y="0" width="535" height="30" textAlignment="Center"/>
				<font size="16" isBold="true"/>
				<text><![CDATA[Exam Schedule Report]]></text>
			</staticText>
		</band>
	</title>
	<columnHeader>
		<band height="25">
			<staticText><reportElement x="0" y="0" width="60" height="20"/><text><![CDATA[Exam ID]]></text></staticText>
			<staticText><reportElement x="60" y="0" width="100" height="20"/><text><![CDATA[Exam Name]]></text></staticText>
			<staticText><reportElement x="160" y="0" width="80" height="20"/><text><![CDATA[Subject]]></text></staticText>
			<staticText><reportElement x="240" y="0" width="60" height="20"/><text><![CDATA[Grade]]></text></staticText>
			<staticText><reportElement x="300" y="0" width="80" height="20"/><text><![CDATA[Date]]></text></staticText>
			<staticText><reportElement x="380" y="0" width="60" height="20"/><text><![CDATA[Marks]]></text></staticText>
		</band>
	</columnHeader>
	<detail>
		<band height="25">
			<textField><reportElement x="0" y="0" width="60" height="20"/><textFieldExpression><![CDATA[$F{exam_id}]]></textFieldExpression></textField>
			<textField><reportElement x="60" y="0" width="100" height="20"/><textFieldExpression><![CDATA[$F{exam_name}]]></textFieldExpression></textField>
			<textField><reportElement x="160" y="0" width="80" height="20"/><textFieldExpression><![CDATA[$F{subject_name}]]></textFieldExpression></textField>
			<textField><reportElement x="240" y="0" width="60" height="20"/><textFieldExpression><![CDATA[$F{grade_name}]]></textFieldExpression></textField>
			<textField pattern="yyyy-MM-dd"><reportElement x="300" y="0" width="80" height="20"/><textFieldExpression><![CDATA[$F{exam_date}]]></textFieldExpression></textField>
			<textField><reportElement x="380" y="0" width="60" height="20"/><textFieldExpression><![CDATA[$F{max_marks}]]></textFieldExpression></textField>
		</band>
	</detail>
</jasperReport>