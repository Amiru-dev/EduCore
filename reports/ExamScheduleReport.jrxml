<?xml version="1.0" encoding="UTF-8"?>
<jasperReport name="ExamScheduleReport" pageWidth="595" pageHeight="842" columnWidth="535" leftMargin="30" rightMargin="30" topMargin="20" bottomMargin="20">
	<query>
		<![CDATA[SELECT e.exam_id, e.exam_name, sub.subject_name, g.grade_name, e.exam_date, e.max_marks, et.exam_type_name
		FROM exam e
		JOIN subject sub ON e.subject_id = sub.subject_id
		JOIN grade g ON e.grade_id = g.grade_id
		JOIN exam_type et ON e.exam_type_id = et.exam_type_id
		ORDER BY e.exam_date DESC]]>
	</query>
	<field name="exam_id" class="java.lang.Integer"/>
	<field name="exam_name" class="java.lang.String"/>
	<field name="subject_name" class="java.lang.String"/>
	<field name="grade_name" class="java.lang.String"/>
	<field name="exam_date" class="java.sql.Date"/>
	<field name="max_marks" class="java.lang.Double"/>
	<field name="exam_type_name" class="java.lang.String"/>
	<title height="50">
		<element kind="staticText" x="0" y="0" width="535" height="30" hTextAlign="Center" fontSize="16" bold="true">
			<text><![CDATA[Exam Schedule Report]]></text>
		</element>
	</title>
	<pageHeader height="30">
		<element kind="staticText" x="0" y="0" width="200" height="20">
			<text><![CDATA[Central College Anuradhapura]]></text>
		</element>
	</pageHeader>
	<columnHeader height="25">
		<element kind="staticText" x="0" y="0" width="60" height="20">
			<text><![CDATA[Exam ID]]></text>
		</element>
		<element kind="staticText" x="60" y="0" width="100" height="20">
			<text><![CDATA[Exam Name]]></text>
		</element>
		<element kind="staticText" x="160" y="0" width="80" height="20">
			<text><![CDATA[Subject]]></text>
		</element>
		<element kind="staticText" x="240" y="0" width="60" height="20">
			<text><![CDATA[Grade]]></text>
		</element>
		<element kind="staticText" x="300" y="0" width="80" height="20">
			<text><![CDATA[Date]]></text>
		</element>
		<element kind="staticText" x="380" y="0" width="60" height="20">
			<text><![CDATA[Marks]]></text>
		</element>
	</columnHeader>
	<detail>
		<band height="25">
			<element kind="textField" x="0" y="0" width="60" height="20">
				<expression><![CDATA[$F{exam_id}]]></expression>
			</element>
			<element kind="textField" x="60" y="0" width="100" height="20">
				<expression><![CDATA[$F{exam_name}]]></expression>
			</element>
			<element kind="textField" x="160" y="0" width="80" height="20">
				<expression><![CDATA[$F{subject_name}]]></expression>
			</element>
			<element kind="textField" x="240" y="0" width="60" height="20">
				<expression><![CDATA[$F{grade_name}]]></expression>
			</element>
			<element kind="textField" x="300" y="0" width="80" height="20" pattern="yyyy-MM-dd">
				<expression><![CDATA[$F{exam_date}]]></expression>
			</element>
			<element kind="textField" x="380" y="0" width="60" height="20">
				<expression><![CDATA[$F{max_marks}]]></expression>
			</element>
		</band>
	</detail>
	<pageFooter height="30">
		<element kind="textField" x="0" y="10" width="535" height="20" hTextAlign="Center">
			<expression><![CDATA["Page " + $V{PAGE_NUMBER} + " of " + $V{PAGE_COUNT}]]></expression>
		</element>
	</pageFooter>
</jasperReport>
