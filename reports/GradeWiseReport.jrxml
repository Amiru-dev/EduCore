<?xml version="1.0" encoding="UTF-8"?>
<jasperReport xmlns="http://jasperreports.sourceforge.net/jasperreports" name="GradeWiseReport" pageWidth="595" pageHeight="842" columnWidth="535" leftMargin="30" rightMargin="30" topMargin="20" bottomMargin="20">
	<parameter name="grade_id" class="java.lang.Integer"/>
	<queryString>
		SELECT s.student_id, s.first_name, s.last_name, g.grade_name, s.registration_date
		FROM student s
		JOIN grade g ON s.grade_id = g.grade_id
		WHERE s.grade_id = $P{grade_id} AND s.is_active = 1
		ORDER BY s.student_id
	</queryString>
	<field name="student_id" class="java.lang.String"/>
	<field name="first_name" class="java.lang.String"/>
	<field name="last_name" class="java.lang.String"/>
	<field name="grade_name" class="java.lang.String"/>
	<field name="registration_date" class="java.sql.Date"/>
	<title>
		<band height="50">
			<staticText>
				<reportElement x="0" y="0" width="535" height="30" textAlignment="Center"/>
				<font size="16" isBold="true"/>
				<text><![CDATA[Grade Wise Student Report]]></text>
			</staticText>
		</band>
	</title>
	<columnHeader>
		<band height="25">
			<staticText><reportElement x="0" y="0" width="80" height="20"/><text><![CDATA[Student ID]]></text></staticText>
			<staticText><reportElement x="80" y="0" width="120" height="20"/><text><![CDATA[Name]]></text></staticText>
			<staticText><reportElement x="200" y="0" width="80" height="20"/><text><![CDATA[Grade]]></text></staticText>
			<staticText><reportElement x="280" y="0" width="100" height="20"/><text><![CDATA[Registration Date]]></text></staticText>
		</band>
	</columnHeader>
	<detail>
		<band height="25">
			<textField><reportElement x="0" y="0" width="80" height="20"/><textFieldExpression><![CDATA[$F{student_id}]]></textFieldExpression></textField>
			<textField><reportElement x="80" y="0" width="120" height="20"/><textFieldExpression><![CDATA[$F{first_name} + " " + $F{last_name}]]></textFieldExpression></textField>
			<textField><reportElement x="200" y="0" width="80" height="20"/><textFieldExpression><![CDATA[$F{grade_name}]]></textFieldExpression></textField>
			<textField pattern="yyyy-MM-dd"><reportElement x="280" y="0" width="100" height="20"/><textFieldExpression><![CDATA[$F{registration_date}]]></textFieldExpression></textField>
		</band>
	</detail>
</jasperReport>