<?xml version="1.0" encoding="UTF-8"?>
<jasperReport name="GradeWiseReport" pageWidth="595" pageHeight="842" columnWidth="535" leftMargin="30" rightMargin="30" topMargin="20" bottomMargin="20">
	<parameter name="grade_id" class="java.lang.Integer"/>
	<query>
		<![CDATA[SELECT s.student_id, s.first_name, s.last_name, g.grade_name, s.registration_date
		FROM student s
		JOIN grade g ON s.grade_id = g.grade_id
		WHERE s.grade_id = $P{grade_id} AND s.is_active = 1
		ORDER BY s.student_id]]>
	</query>
	<field name="student_id" class="java.lang.String"/>
	<field name="first_name" class="java.lang.String"/>
	<field name="last_name" class="java.lang.String"/>
	<field name="grade_name" class="java.lang.String"/>
	<field name="registration_date" class="java.sql.Date"/>
	<title height="50">
		<element kind="staticText" x="0" y="0" width="535" height="30" hTextAlign="Center" fontSize="16" bold="true">
			<text><![CDATA[Grade Wise Student Report]]></text>
		</element>
	</title>
	<pageHeader height="30">
		<element kind="staticText" x="0" y="0" width="200" height="20">
			<text><![CDATA[Central College Anuradhapura]]></text>
		</element>
	</pageHeader>
	<columnHeader height="25">
		<element kind="staticText" x="0" y="0" width="80" height="20">
			<text><![CDATA[Student ID]]></text>
		</element>
		<element kind="staticText" x="80" y="0" width="120" height="20">
			<text><![CDATA[Name]]></text>
		</element>
		<element kind="staticText" x="200" y="0" width="80" height="20">
			<text><![CDATA[Grade]]></text>
		</element>
		<element kind="staticText" x="280" y="0" width="100" height="20">
			<text><![CDATA[Registration Date]]></text>
		</element>
	</columnHeader>
	<detail>
		<band height="25">
			<element kind="textField" x="0" y="0" width="80" height="20">
				<expression><![CDATA[$F{student_id}]]></expression>
			</element>
			<element kind="textField" x="80" y="0" width="120" height="20">
				<expression><![CDATA[$F{first_name} + " " + $F{last_name}]]></expression>
			</element>
			<element kind="textField" x="200" y="0" width="80" height="20">
				<expression><![CDATA[$F{grade_name}]]></expression>
			</element>
			<element kind="textField" x="280" y="0" width="100" height="20" pattern="yyyy-MM-dd">
				<expression><![CDATA[$F{registration_date}]]></expression>
			</element>
		</band>
	</detail>
	<pageFooter height="30">
		<element kind="textField" x="0" y="10" width="535" height="20" hTextAlign="Center">
			<expression><![CDATA["Page " + $V{PAGE_NUMBER} + " of " + $V{PAGE_COUNT}]]></expression>
		</element>
	</pageFooter>
</jasperReport>
