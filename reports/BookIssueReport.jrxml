<?xml version="1.0" encoding="UTF-8"?>
<jasperReport name="BookIssueReport" pageWidth="595" pageHeight="842" columnWidth="535" leftMargin="30" rightMargin="30" topMargin="20" bottomMargin="20">
	<query>
		<![CDATA[SELECT bi.borrow_id, b.ISBN, b.title, s.student_id, s.first_name, s.last_name, bi.issue_date, bi.due_date, bi.return_date
		FROM book_issue bi
		JOIN book b ON bi.ISBN = b.ISBN
		JOIN student s ON bi.student_id = s.student_id
		ORDER BY bi.issue_date DESC]]>
	</query>
	<field name="borrow_id" class="java.lang.Integer"/>
	<field name="ISBN" class="java.lang.String"/>
	<field name="title" class="java.lang.String"/>
	<field name="student_id" class="java.lang.String"/>
	<field name="first_name" class="java.lang.String"/>
	<field name="last_name" class="java.lang.String"/>
	<field name="issue_date" class="java.sql.Date"/>
	<field name="due_date" class="java.sql.Date"/>
	<field name="return_date" class="java.sql.Date"/>
	<title height="50">
		<element kind="staticText" x="0" y="0" width="535" height="30" hTextAlign="Center" fontSize="16" bold="true">
			<text><![CDATA[Book Issue Report]]></text>
		</element>
	</title>
	<pageHeader height="30">
		<element kind="staticText" x="0" y="0" width="200" height="20">
			<text><![CDATA[Central College Anuradhapura]]></text>
		</element>
	</pageHeader>
	<columnHeader height="25">
		<element kind="staticText" x="0" y="0" width="60" height="20">
			<text><![CDATA[ISBN]]></text>
		</element>
		<element kind="staticText" x="60" y="0" width="100" height="20">
			<text><![CDATA[Book Title]]></text>
		</element>
		<element kind="staticText" x="160" y="0" width="80" height="20">
			<text><![CDATA[Student ID]]></text>
		</element>
		<element kind="staticText" x="240" y="0" width="80" height="20">
			<text><![CDATA[Issue Date]]></text>
		</element>
		<element kind="staticText" x="320" y="0" width="80" height="20">
			<text><![CDATA[Due Date]]></text>
		</element>
		<element kind="staticText" x="400" y="0" width="80" height="20">
			<text><![CDATA[Return Date]]></text>
		</element>
	</columnHeader>
	<detail>
		<band height="25">
			<element kind="textField" x="0" y="0" width="60" height="20">
				<expression><![CDATA[$F{ISBN}]]></expression>
			</element>
			<element kind="textField" x="60" y="0" width="100" height="20">
				<expression><![CDATA[$F{title}]]></expression>
			</element>
			<element kind="textField" x="160" y="0" width="80" height="20">
				<expression><![CDATA[$F{student_id}]]></expression>
			</element>
			<element kind="textField" x="240" y="0" width="80" height="20" pattern="yyyy-MM-dd">
				<expression><![CDATA[$F{issue_date}]]></expression>
			</element>
			<element kind="textField" x="320" y="0" width="80" height="20" pattern="yyyy-MM-dd">
				<expression><![CDATA[$F{due_date}]]></expression>
			</element>
			<element kind="textField" x="400" y="0" width="80" height="20" pattern="yyyy-MM-dd">
				<expression><![CDATA[$F{return_date}]]></expression>
			</element>
		</band>
	</detail>
	<pageFooter height="30">
		<element kind="textField" x="0" y="10" width="535" height="20" hTextAlign="Center">
			<expression><![CDATA["Page " + $V{PAGE_NUMBER} + " of " + $V{PAGE_COUNT}]]></expression>
		</element>
	</pageFooter>
</jasperReport>
