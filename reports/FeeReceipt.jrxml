<?xml version="1.0" encoding="UTF-8"?>
<jasperReport name="FeeReceipt" pageWidth="595" pageHeight="842" columnWidth="535" leftMargin="30" rightMargin="30" topMargin="20" bottomMargin="20">
	<parameter name="fee_id" class="java.lang.Integer"/>
	<query>
		<![CDATA[SELECT f.receipt_no, f.student_id, s.first_name, s.last_name, ft.fee_type_name, f.amount, f.due_date, f.paid_date, pm.method_name
		FROM fee f
		JOIN student s ON f.student_id = s.student_id
		JOIN fee_type ft ON f.fee_type_id = ft.fee_type_id
		LEFT JOIN payment_method pm ON f.payment_method_id = pm.payment_method_id
		WHERE f.fee_id = $P{fee_id}]]>
	</query>
	<field name="receipt_no" class="java.lang.String"/>
	<field name="student_id" class="java.lang.String"/>
	<field name="first_name" class="java.lang.String"/>
	<field name="last_name" class="java.lang.String"/>
	<field name="fee_type_name" class="java.lang.String"/>
	<field name="amount" class="java.lang.Double"/>
	<field name="due_date" class="java.sql.Date"/>
	<field name="paid_date" class="java.sql.Date"/>
	<field name="method_name" class="java.lang.String"/>
	<title height="50">
		<element kind="staticText" x="0" y="0" width="535" height="30" hTextAlign="Center" fontSize="18" bold="true">
			<text><![CDATA[FEE RECEIPT]]></text>
		</element>
	</title>
	<pageHeader height="40">
		<element kind="staticText" x="0" y="0" width="280" height="20" fontSize="14" bold="true">
			<text><![CDATA[Central College Anuradhapura]]></text>
		</element>
		<element kind="staticText" x="0" y="20" width="200" height="20" fontSize="12">
			<text><![CDATA[School Management System]]></text>
		</element>
	</pageHeader>
	<detail>
		<band height="250">
			<element kind="staticText" x="0" y="23" width="100" height="20">
				<text><![CDATA[Receipt No:]]></text>
			</element>
			<element kind="textField" x="100" y="23" width="200" height="20">
				<expression><![CDATA[$F{receipt_no}]]></expression>
			</element>
			<element kind="staticText" x="0" y="53" width="100" height="20">
				<text><![CDATA[Student ID:]]></text>
			</element>
			<element kind="textField" x="100" y="53" width="200" height="20">
				<expression><![CDATA[$F{student_id}]]></expression>
			</element>
			<element kind="staticText" x="0" y="83" width="100" height="20">
				<text><![CDATA[Student Name:]]></text>
			</element>
			<element kind="textField" x="100" y="83" width="200" height="20">
				<expression><![CDATA[$F{first_name} + " " + $F{last_name}]]></expression>
			</element>
			<element kind="staticText" x="0" y="113" width="100" height="20">
				<text><![CDATA[Fee Type:]]></text>
			</element>
			<element kind="textField" x="100" y="113" width="200" height="20">
				<expression><![CDATA[$F{fee_type_name}]]></expression>
			</element>
			<element kind="staticText" x="0" y="143" width="100" height="20">
				<text><![CDATA[Amount:]]></text>
			</element>
			<element kind="staticText" x="100" y="143" width="25" height="20">
				<text><![CDATA[Rs.]]></text>
			</element>
			<element kind="textField" x="125" y="143" width="175" height="20" pattern="#,##0.00">
				<expression><![CDATA[$F{amount}]]></expression>
			</element>
			<element kind="staticText" x="0" y="173" width="100" height="20">
				<text><![CDATA[Paid Date:]]></text>
			</element>
			<element kind="textField" x="100" y="173" width="200" height="20" pattern="yyyy-MM-dd">
				<expression><![CDATA[$F{paid_date}]]></expression>
			</element>
			<element kind="staticText" x="0" y="203" width="100" height="20">
				<text><![CDATA[Payment Method:]]></text>
			</element>
			<element kind="textField" x="100" y="203" width="200" height="20">
				<expression><![CDATA[$F{method_name}]]></expression>
			</element>
		</band>
	</detail>
</jasperReport>
