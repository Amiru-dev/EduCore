<?xml version="1.0" encoding="UTF-8"?>
<jasperReport xmlns="http://jasperreports.sourceforge.net/jasperreports" xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance" xsi:schemaLocation="http://jasperreports.sourceforge.net/jasperreports http://jasperreports.sourceforge.net/xsd/jasperreport.xsd" name="FeeReceipt" pageWidth="595" pageHeight="842" columnWidth="535" leftMargin="30" rightMargin="30" topMargin="20" bottomMargin="20">
	<parameter name="fee_id" class="java.lang.Integer"/>
	<queryString>
		SELECT f.receipt_no, f.student_id, s.first_name, s.last_name, ft.fee_type_name, f.amount, f.due_date, f.paid_date, pm.method_name
		FROM fee f
		JOIN student s ON f.student_id = s.student_id
		JOIN fee_type ft ON f.fee_type_id = ft.fee_type_id
		LEFT JOIN payment_method pm ON f.payment_method_id = pm.payment_method_id
		WHERE f.fee_id = $P{fee_id}
	</queryString>
	<field name="receipt_no" class="java.lang.String"/>
	<field name="student_id" class="java.lang.String"/>
	<field name="first_name" class="java.lang.String"/>
	<field name="last_name" class="java.lang.String"/>
	<field name="fee_type_name" class="java.lang.String"/>
	<field name="amount" class="java.lang.Double"/>
	<field name="due_date" class="java.sql.Date"/>
	<field name="paid_date" class="java.sql.Date"/>
	<field name="method_name" class="java.lang.String"/>
	<title>
		<band height="50">
			<staticText>
				<reportElement x="0" y="0" width="535" height="30" textAlignment="Center"/>
				<font size="18" isBold="true"/>
				<text><![CDATA[FEE RECEIPT]]></text>
			</staticText>
		</band>
	</title>
	<pageHeader>
		<band height="40">
			<staticText>
				<reportElement x="0" y="0" width="200" height="20"/>
				<font size="14" isBold="true"/>
				<text><![CDATA[Central College Anuradhapura]]></text>
			</staticText>
			<staticText>
				<reportElement x="0" y="20" width="200" height="20"/>
				<text><![CDATA[School Management System]]></text>
			</staticText>
		</band>
	</pageHeader>
	<detail>
		<band height="250">
			<staticText>
				<reportElement x="0" y="0" width="100" height="20"/>
				<text><![CDATA[Receipt No:]]></text>
			</staticText>
			<textField>
				<reportElement x="100" y="0" width="200" height="20"/>
				<textFieldExpression><![CDATA[$F{receipt_no}]]></textFieldExpression>
			</textField>
			<staticText>
				<reportElement x="0" y="30" width="100" height="20"/>
				<text><![CDATA[Student ID:]]></text>
			</staticText>
			<textField>
				<reportElement x="100" y="30" width="200" height="20"/>
				<textFieldExpression><![CDATA[$F{student_id}]]></textFieldExpression>
			</textField>
			<staticText>
				<reportElement x="0" y="60" width="100" height="20"/>
				<text><![CDATA[Student Name:]]></text>
			</staticText>
			<textField>
				<reportElement x="100" y="60" width="200" height="20"/>
				<textFieldExpression><![CDATA[$F{first_name} + " " + $F{last_name}]]></textFieldExpression>
			</textField>
			<staticText>
				<reportElement x="0" y="90" width="100" height="20"/>
				<text><![CDATA[Fee Type:]]></text>
			</staticText>
			<textField>
				<reportElement x="100" y="90" width="200" height="20"/>
				<textFieldExpression><![CDATA[$F{fee_type_name}]]></textFieldExpression>
			</textField>
			<staticText>
				<reportElement x="0" y="120" width="100" height="20"/>
				<text><![CDATA[Amount:]]></text>
			</staticText>
			<textField pattern="Rs. #,##0.00">
				<reportElement x="100" y="120" width="200" height="20"/>
				<textFieldExpression><![CDATA[$F{amount}]]></textFieldExpression>
			</textField>
			<staticText>
				<reportElement x="0" y="150" width="100" height="20"/>
				<text><![CDATA[Paid Date:]]></text>
			</staticText>
			<textField pattern="yyyy-MM-dd">
				<reportElement x="100" y="150" width="200" height="20"/>
				<textFieldExpression><![CDATA[$F{paid_date}]]></textFieldExpression>
			</textField>
			<staticText>
				<reportElement x="0" y="180" width="100" height="20"/>
				<text><![CDATA[Payment Method:]]></text>
			</staticText>
			<textField>
				<reportElement x="100" y="180" width="200" height="20"/>
				<textFieldExpression><![CDATA[$F{method_name}]]></textFieldExpression>
			</textField>
		</band>
	</detail>
</jasperReport>