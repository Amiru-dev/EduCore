<jasperReport xmlns="http://jasperreports.sourceforge.net/jasperreports" xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance" xsi:schemaLocation="http://jasperreports.sourceforge.net/jasperreports http://jasperreports.sourceforge.net/xsd/jasperreport.xsd" name="FeeReceipt" pageWidth="595" pageHeight="842" columnWidth="535" leftMargin="30" rightMargin="30" topMargin="20" bottomMargin="20" uuid="c86cf5b6-609a-42f3-9b46-153a90549773">
	<parameter name="fee_id" class="java.lang.Integer"/>
	<queryString>
		<![CDATA[SELECT f.receipt_no, f.student_id, s.first_name, s.last_name, ft.fee_type_name, f.amount, f.due_date, f.paid_date, pm.method_name
		FROM fee f
		JOIN student s ON f.student_id = s.student_id
		JOIN fee_type ft ON f.fee_type_id = ft.fee_type_id
		LEFT JOIN payment_method pm ON f.payment_method_id = pm.payment_method_id
		WHERE f.fee_id = $P{fee_id}]]>
	</queryString>
	<field name="receipt_no" class="java.lang.String"/>
	<field name="student_id" class="java.lang.String"/>
	<field name="first_name" class="java.lang.String"/>
	<field name="last_name" class="java.lang.String"/>
	<field name="fee_type_name" class="java.lang.String"/>
	<field name="amount" class="java.lang.Double"/>
	<field name="due_date" class="java.sql.Date"/>
	<field name="paid_date" class="java.sql.Date"/>
	<field name="method_name" class="java.lang.String"/>
