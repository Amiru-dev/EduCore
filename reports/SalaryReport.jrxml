<?xml version="1.0" encoding="UTF-8"?>
<jasperReport name="SalaryReport" pageWidth="595" pageHeight="842" columnWidth="535" leftMargin="30" rightMargin="30" topMargin="20" bottomMargin="20">
	<query>
		<![CDATA[SELECT t.NIC, t.first_name, t.last_name, t.salary, ts.status_name
		FROM teacher t
		JOIN teacher_status ts ON t.status_id = ts.status_id
		ORDER BY t.first_name, t.last_name]]>
	</query>
	<field name="NIC" class="java.lang.String"/>
	<field name="first_name" class="java.lang.String"/>
	<field name="last_name" class="java.lang.String"/>
	<field name="salary" class="java.lang.Double"/>
	<field name="status_name" class="java.lang.String"/>
	<title height="50">
		<element kind="staticText" x="0" y="0" width="535" height="30" hTextAlign="Center" fontSize="16" bold="true">
			<text><![CDATA[Salary Report]]></text>
		</element>
	</title>
	<pageHeader height="30">
		<element kind="staticText" x="0" y="0" width="200" height="20">
			<text><![CDATA[Central College Anuradhapura]]></text>
		</element>
	</pageHeader>
	<columnHeader height="25">
		<element kind="staticText" x="0" y="0" width="80" height="20">
			<text><![CDATA[NIC]]></text>
		</element>
		<element kind="staticText" x="80" y="0" width="100" height="20">
			<text><![CDATA[Name]]></text>
		</element>
		<element kind="staticText" x="180" y="0" width="80" height="20">
			<text><![CDATA[Salary]]></text>
		</element>
		<element kind="staticText" x="260" y="0" width="100" height="20">
			<text><![CDATA[Status]]></text>
		</element>
	</columnHeader>
	<detail>
		<band height="25">
			<element kind="textField" x="0" y="0" width="80" height="20">
				<expression><![CDATA[$F{NIC}]]></expression>
			</element>
			<element kind="textField" x="80" y="0" width="100" height="20">
				<expression><![CDATA[$F{first_name} + " " + $F{last_name}]]></expression>
			</element>
			<element kind="staticText" x="180" y="0" width="25" height="20">
				<text><![CDATA[Rs.]]></text>
			</element>
			<element kind="textField" x="205" y="0" width="55" height="20" pattern="#,##0.00">
				<expression><![CDATA[$F{salary}]]></expression>
			</element>
			<element kind="textField" x="260" y="0" width="100" height="20">
				<expression><![CDATA[$F{status_name}]]></expression>
			</element>
		</band>
	</detail>
	<pageFooter height="30">
		<element kind="textField" x="0" y="10" width="535" height="20" hTextAlign="Center">
			<expression><![CDATA["Page " + $V{PAGE_NUMBER} + " of " + $V{PAGE_COUNT}]]></expression>
		</element>
	</pageFooter>
</jasperReport>
