	<queryString>
		<![CDATA[SELECT t.NIC, t.first_name, t.last_name, t.email, t.phone, tt.type_name, t.salary, ts.status_name
		FROM teacher t
		JOIN teacher_type tt ON t.teacher_type_id = tt.teacher_type_id
		JOIN teacher_status ts ON t.status_id = ts.status_id
		ORDER BY t.first_name, t.last_name]]>
	</queryString>
